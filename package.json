{
  "name": "claudeset",
  "version": "0.1.0",
  "description": "Bootstrap Claude Code config, project memory, RTK prompts and Caveman support into any project — idempotent and safe to re-run.",
  "type": "module",
  "bin": {
    "claudeset": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themespack/claudeset.git"
  },
  "homepage": "https://github.com/themespack/claudeset#readme",
  "bugs": {
    "url": "https://github.com/themespack/claudeset/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "bootstrap",
    "scaffold",
    "memory",
    "rtk",
    "caveman"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
